{{- /* Request binding shared by the server templates.

"requestErrorType" declares RequestError; called with true for Echo, which also gets newRequestError.

"param" binds one in: query, in: header or in: cookie param. Called with
dict "Source" ("query"|"header"|"cookie") "Echo" bool "Writer" string "Handler" string "Target" string "Param" parameterData.
An empty query value or header counts as absent; an empty cookie counts as present.

"reject" answers 400 through the request error handler. Called with
dict "Echo" bool "Writer" string "Handler" string "In" string "Name" string "Reason" ("missing"|"invalid") "Err" (expression or ""). */ -}}
{{- define "requestErrorType" }}

// RequestError reports a request rejected before the operation was called.
// Error returns the text sent to the client. Err can quote the raw input, so
// keep it out of responses.
type RequestError struct {
	// In is where the value was expected: path, query, querystring, header, cookie or body.
	In string
	// Name is the parameter name as written in the spec; empty for the body.
	Name string
	// Reason is "missing" or "invalid".
	Reason string
	// Err is the parse error, if any.
	Err error
}

func (e *RequestError) Error() string {
	switch e.In {
	case "body":
		return "invalid request body"
	case "querystring":
		return "invalid querystring"
	}
	return e.Reason + " " + e.Name
}

func (e *RequestError) Unwrap() error { return e.Err }

// Location returns In. With Parameter and Missing it lets one interface match
// the request errors of every generated package.
func (e *RequestError) Location() string { return e.In }

// Parameter returns Name.
func (e *RequestError) Parameter() string { return e.Name }

// Missing reports whether a required value was absent.
func (e *RequestError) Missing() bool { return e.Reason == "missing" }
{{- if . }}

func newRequestError(re *RequestError) error {
	return echo.NewHTTPError(http.StatusBadRequest, re.Error()).SetInternal(re)
}
{{- end }}
{{- end }}

{{- define "param" }}
{{- $echo := .Echo }}
{{- $writer := .Writer }}
{{- $handler := .Handler }}
{{- $target := .Target }}
{{- $source := .Source }}
{{- $value := "v" }}
{{- if eq $source "cookie" }}{{ $value = "c.Value" }}{{ end }}
{{- with .Param }}
{{- if hasPrefix .Type "[]" }}
{{- if eq $source "query" }}
	if values := {{ if $echo }}ctx.QueryParams(){{ else }}r.URL.Query(){{ end }}["{{ .Name }}"]; len(values) > 0 {
{{- else }}
	if values := {{ if $echo }}ctx.Request().Header{{ else }}r.Header{{ end }}.Values("{{ .Name }}"); len(values) > 0 {
{{- end }}
{{- if .IsEnumArray }}
		typed := make({{ .Type }}, len(values))
		for i, v := range values {
			typed[i] = {{ trimPrefix .Type "[]" }}(v)
			if !typed[i].IsValid() {
{{- template "reject" dict "Echo" $echo "Writer" $writer "Handler" $handler "In" $source "Name" .Name "Reason" "invalid" "Err" "" }}
			}
		}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}typed
{{- else }}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}values
{{- end }}
	}{{ if .Required }} else {
{{- template "reject" dict "Echo" $echo "Writer" $writer "Handler" $handler "In" $source "Name" .Name "Reason" "missing" "Err" "" }}
	}{{ end }}
{{- else }}
{{- if eq $source "query" }}
	if v := {{ if $echo }}ctx.QueryParam{{ else }}r.URL.Query().Get{{ end }}("{{ .Name }}"); v != "" {
{{- else if eq $source "header" }}
	if v := {{ if $echo }}ctx.Request().Header{{ else }}r.Header{{ end }}.Get("{{ .Name }}"); v != "" {
{{- else }}
	if c, err := {{ if $echo }}ctx.Cookie{{ else }}r.Cookie{{ end }}("{{ .Name }}"); err == nil {
{{- end }}
{{- if eq .Type "string" }}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}{{ $value }}
{{- else if .IsEnum }}
		typed := {{ .Type }}({{ $value }})
		if !typed.IsValid() {
{{- template "reject" dict "Echo" $echo "Writer" $writer "Handler" $handler "In" $source "Name" .Name "Reason" "invalid" "Err" "" }}
		}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}typed
{{- else if eq .Type "int" "int32" "int64" "float64" "bool" "uuid.UUID" "time.Time" }}
{{- if eq .Type "int" }}
		parsed, err := strconv.Atoi({{ $value }})
{{- else if eq .Type "int32" }}
		parsed64, err := strconv.ParseInt({{ $value }}, 10, 32)
		parsed := int32(parsed64)
{{- else if eq .Type "int64" }}
		parsed, err := strconv.ParseInt({{ $value }}, 10, 64)
{{- else if eq .Type "float64" }}
		parsed, err := strconv.ParseFloat({{ $value }}, 64)
{{- else if eq .Type "bool" }}
		parsed, err := strconv.ParseBool({{ $value }})
{{- else if eq .Type "uuid.UUID" }}
		var parsed uuid.UUID
		err := parsed.UnmarshalText([]byte({{ $value }}))
{{- else }}
		parsed, err := time.Parse(time.RFC3339, {{ $value }})
{{- end }}
		if err != nil {
{{- template "reject" dict "Echo" $echo "Writer" $writer "Handler" $handler "In" $source "Name" .Name "Reason" "invalid" "Err" "err" }}
		}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}parsed
{{- else }}
		typed := {{ .Type }}({{ $value }})
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}typed
{{- end }}
	}{{ if .Required }} else {
{{- template "reject" dict "Echo" $echo "Writer" $writer "Handler" $handler "In" $source "Name" .Name "Reason" "missing" "Err" "" }}
	}{{ end }}
{{- end }}
{{- end }}
{{- end }}

{{- define "reject" }}
{{- if .Echo }}
		return newRequestError(&RequestError{In: "{{ .In }}", Name: "{{ .Name }}", Reason: "{{ .Reason }}"{{ if .Err }}, Err: {{ .Err }}{{ end }}})
{{- else }}
		{{ .Handler }}({{ .Writer }}, r, &RequestError{In: "{{ .In }}", Name: "{{ .Name }}", Reason: "{{ .Reason }}"{{ if .Err }}, Err: {{ .Err }}{{ end }}})
		return
{{- end }}
{{- end }}
