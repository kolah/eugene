{{- /* Binds one scalar in: query, in: header or in: cookie param.
Called with dict "Source" ("query"|"header"|"cookie") "Echo" bool "Writer" string "Target" string "Param" parameterData.
An empty query value or header counts as absent; an empty cookie counts as present. */ -}}
{{- define "scalarParam" }}
{{- $echo := .Echo }}
{{- $writer := .Writer }}
{{- $target := .Target }}
{{- $source := .Source }}
{{- $value := "v" }}
{{- if eq $source "cookie" }}{{ $value = "c.Value" }}{{ end }}
{{- with .Param }}
{{- if eq $source "query" }}
	if v := {{ if $echo }}ctx.QueryParam{{ else }}r.URL.Query().Get{{ end }}("{{ .Name }}"); v != "" {
{{- else if eq $source "header" }}
	if v := {{ if $echo }}ctx.Request().Header{{ else }}r.Header{{ end }}.Get("{{ .Name }}"); v != "" {
{{- else }}
	if c, err := {{ if $echo }}ctx.Cookie{{ else }}r.Cookie{{ end }}("{{ .Name }}"); err == nil {
{{- end }}
{{- if eq .Type "string" }}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}{{ $value }}
{{- else if .IsEnum }}
		typed := {{ .Type }}({{ $value }})
		if !typed.IsValid() {
{{- template "paramError" dict "Echo" $echo "Writer" $writer "Message" (printf "invalid %s" .Name) }}
		}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}typed
{{- else if eq .Type "int" "int32" "int64" "float64" "bool" "uuid.UUID" "time.Time" }}
{{- if eq .Type "int" }}
		parsed, err := strconv.Atoi({{ $value }})
{{- else if eq .Type "int32" }}
		parsed64, err := strconv.ParseInt({{ $value }}, 10, 32)
		parsed := int32(parsed64)
{{- else if eq .Type "int64" }}
		parsed, err := strconv.ParseInt({{ $value }}, 10, 64)
{{- else if eq .Type "float64" }}
		parsed, err := strconv.ParseFloat({{ $value }}, 64)
{{- else if eq .Type "bool" }}
		parsed, err := strconv.ParseBool({{ $value }})
{{- else if eq .Type "uuid.UUID" }}
		var parsed uuid.UUID
		err := parsed.UnmarshalText([]byte({{ $value }}))
{{- else }}
		parsed, err := time.Parse(time.RFC3339, {{ $value }})
{{- end }}
		if err != nil {
{{- template "paramError" dict "Echo" $echo "Writer" $writer "Message" (printf "invalid %s" .Name) }}
		}
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}parsed
{{- else }}
		typed := {{ .Type }}({{ $value }})
		{{ $target }}.{{ .GoName }} = {{ if not .Required }}&{{ end }}typed
{{- end }}
	}{{ if .Required }} else {
{{- template "paramError" dict "Echo" $echo "Writer" $writer "Message" (printf "missing %s" .Name) }}
	}{{ end }}
{{- end }}
{{- end }}

{{- define "paramError" }}
{{- if .Echo }}
		return echo.NewHTTPError(http.StatusBadRequest, "{{ .Message }}")
{{- else }}
		http.Error({{ .Writer }}, "{{ .Message }}", http.StatusBadRequest)
		return
{{- end }}
{{- end }}
